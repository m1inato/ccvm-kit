{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "doh",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "clash"
      }
    ],
    "final": "doh",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sb-tun",
      "address": ["172.31.255.1/30"],
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "auto_redirect": false,
      "dns_mode": "disabled",
      "route_exclude_address": ["192.168.5.0/24"],
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "clash",
      "server": "192.168.5.2",
      "server_port": 17897,
      "version": "5",
      "network": "tcp"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      { "port": 53, "action": "hijack-dns" },
      { "ip_is_private": true, "action": "reject" },
      { "network": "udp", "action": "reject" }
    ],
    "final": "clash"
  }
}
