#!/usr/sbin/nft -f
# 锁定模式：仅在主防火墙加载失败时使用（见 ccvm-firewall.service）。
# 只保留 Lima SSH 和 DHCP，任何出网（包括经 TUN）都被拒绝 —— 仍然 fail-closed，
# 但你还能 limactl shell 进去修复，而不是整台 VM 失联。

add table inet ccvm
delete table inet ccvm

table inet ccvm {
  comment "ccvm-lockdown"

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ip saddr 192.168.5.0/24 tcp dport 22 accept
    udp sport 67 udp dport 68 accept
  }

  chain output {
    type filter hook output priority filter; policy drop;
    oifname "lo" accept
    ip daddr 192.168.5.0/24 tcp sport 22 ct state established accept
    udp sport 68 udp dport 67 accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }
}
